# Copy to .env (git-ignored). Same Redis database for every run, both engines, and the load generator.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Optional free-text recorded in the report
ENGINE_HOST_DESC="c7i.xlarge us-east-1a"
LOADGEN_HOST_DESC="c7i.xlarge us-east-1a"
REDIS_DESC="Upstash us-east-1"

# Optional CPU pinning
# ENGINE_CPU=2
